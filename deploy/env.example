# Copy to .env (next to docker-compose.yml) and adjust. Never commit .env.

# Size profile: pi (Raspberry Pi 5, 8 GB) or vps (>= 4 vCPU, >= 8 GB). Exactly one.
COMPOSE_PROFILES=pi

# Address and port the gateway is published on. Restrict the address to a LAN or VPN interface
# (for example 192.168.1.20 or the WireGuard address) if the server must not be reachable elsewhere.
ZETRU_BIND_ADDRESS=0.0.0.0
ZETRU_PORT=8443

# Subnet of the internal dns network (analyzer -> resolver). Change it only if it collides with
# a network on the host; the resolver's access control follows it automatically.
ZETRU_DNS_SUBNET=172.30.53.0/24

# Gateway request log: file (daily files in the gateway-data volume, deleted after 14 days),
# stdout (Docker log, size-capped) or off.
ZETRU_REQUEST_LOG=file

# RDAP requests per second and registry host, and burst size, for the lookup service.
ZETRU_RDAP_RATE=1
ZETRU_RDAP_BURST=6

# 1 enables feeds and backends whose licence forbids commercial use (concept §6.7). Default off.
ZETRU_ALLOW_NONCOMMERCIAL=0
